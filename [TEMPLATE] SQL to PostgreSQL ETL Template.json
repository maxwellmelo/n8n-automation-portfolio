    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n\nCASE WHEN FLAN_CODCOLIGADA=1 THEN '[SUA EMPRESA]'\n\tWHEN FLAN_CODCOLIGADA=8 THEN 'TRANSCERRADOS III'\n\tWHEN FLAN_CODCOLIGADA=12 THEN '[EMPRESA] OTIMA'\n\tEND AS [EMPRESA],\nGDEPTO_NOME AS OBRA,\nFCFO_CGCCFO AS CNPJOUCPF,\nFLAN_STATUSLAN,\nFCFO_NOME AS FORNECEDOR,\nFLAN_VALORORIGINAL AS [VALOR ORIGINAL],\nFLAN_VALORBAIXADO AS [VALOR BAIXADO],\nFLAN_DATAEMISSAO AS [DATA DE EMISSAO],\nFLAN_DATABAIXA AS [DATA DO PAGAMENTO],\nFTB1_DESCRICAO AS [NATUREZA FINANCEIRA],\nFLAN_HISTORICO AS DESCRICAO,\nTIPO_OPERACIONAL\n\nFROM OKR1\n\nWHERE FLAN_DATAEMISSAO >= GETDATE()-90"
