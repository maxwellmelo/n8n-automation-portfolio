    {
      "parameters": {
        "jsCode": "// Processar a resposta e extrair o conteúdo do relatório\nconst responseBody = $input.first().json.data || '';\n\n// Extrair o conteúdo codificado em base64\nconst fileChunkMatch = responseBody.match(/<GetFileChunkResult>([^<]+)<\\/GetFileChunkResult>/i);\nlet fileChunkBase64 = fileChunkMatch ? fileChunkMatch[1] : null;\n\nif (fileChunkBase64) {\n  // Limpar o conteúdo base64 (remover quebras de linha, espaços, etc.)\n  fileChunkBase64 = fileChunkBase64.replace(/[\\n\\r\\s]/g, '');\n  \n  // Configurar o arquivo binário com o conteúdo decodificado\n  const fileName = `RELATORIO.pdf`;\n  const mimeType = 'application/pdf';\n  \n  // Preparar o objeto de retorno com o binário\n  const newItem = {\n    json: {\n      success: true,\n      fileName: fileName,\n      mimeType: mimeType\n    },\n    binary: {\n      data: {\n        data: fileChunkBase64,\n        mimeType: mimeType,\n        fileName: fileName\n      }\n    }\n  };\n  \n  return newItem;\n} else {\n  // Se não encontrou o conteúdo\n  return {\n    json: {\n      success: false,\n      error: 'Não foi possível extrair o conteúdo do relatório'\n    }\n  };\n}"
      },
