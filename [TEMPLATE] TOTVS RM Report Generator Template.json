        "mode": "runOnceForEachItem",
        "jsCode": "// Obter a string XML\nvar xmlString = $json.data;\n\n// Usar regex para extrair o conteúdo entre <GenerateReportResult>...</GenerateReportResult>\nvar match = xmlString.match(/<GenerateReportResult>(.*?)<\\/GenerateReportResult>/);\n\nif (match && match[1]) {\n  var reportId = match[1];\n  console.log(\"ID extraído:\", reportId);\n  return { id: reportId };\n} else {\n  throw new Error(\"ID não encontrado no XML.\");\n}\n"
      },
