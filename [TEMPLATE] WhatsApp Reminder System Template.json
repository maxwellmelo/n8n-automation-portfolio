        "jsCode": "function normalizeWhatsAppNumber(contato) {\n  if (!contato) {\n    throw new Error('Contato não fornecido');\n  }\n  \n  // Remove tudo que não for número\n  let cleanNumber = contato.toString().replace(/\\D/g, '');\n  \n  // Remove código do país se existir\n  if (cleanNumber.startsWith('55')) {\n    cleanNumber = cleanNumber.substring(2);\n  }\n  \n  let result = '';\n  \n  // Analisa o tamanho para determinar o formato\n  if (cleanNumber.length === 11) {\n    // Formato: DD 9 XXXX-XXXX (11 dígitos)\n    // Pega DDD (2 primeiros) + últimos 8\n    const ddd = cleanNumber.substring(0, 2);\n    const numero = cleanNumber.slice(-8);\n    result = `55${ddd}${numero}`;\n    \n  } else if (cleanNumber.length === 10) {\n    // Formato: DD XXXX-XXXX (10 dígitos - número fixo ou antigo)\n    // Mantém como está\n    result = `55${cleanNumber}`;\n    \n  } else if (cleanNumber.length === 9) {\n    // Provavelmente 9 XXXX-XXXX (falta DDD)\n    console.warn('Número sem DDD - usando DDD padrão ou pedindo ao usuário');\n    // Você pode definir um DDD padrão aqui se quiser\n    result = `55${cleanNumber}`;\n    \n  } else {\n    // Outros casos - usa como está\n    result = `55${cleanNumber}`;\n  }\n  \n  return `${result}@s.whatsapp.net`;\n}\n\nconst contatoNormalizado = normalizeWhatsAppNumber($json.contato);\n\nreturn {\n  ...$json,\n  contato_original: $json.contato,\n  contato_normalizado: contatoNormalizado\n};"
